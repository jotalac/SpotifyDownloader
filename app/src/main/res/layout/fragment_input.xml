    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:src="@drawable/menu_logo"
        android:contentDescription="logo_spotify_downloader"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/editText"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:background="@drawable/edittext_entry"
        android:inputType="text"
        android:hint="Paste a playlist link"
        android:textAlignment="center"
        android:textColorHint="@color/light_gray"
        android:layout_centerInParent="true"
        android:paddingHorizontal="10dp"
        />

    <ImageButton
        android:id="@+id/pasteClipboardButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/download_icon_spotify"
        android:backgroundTint="#689768"
        android:layout_marginVertical="20dp"
        android:layout_below="@id/editText"
        android:layout_centerHorizontal="true"
        android:rotation="-90"
        />

    <ProgressBar
        android:id="@+id/loading_wheel"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_below="@id/editText"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="20dp"
        android:visibility="visible"
        android:indeterminateTint="@color/green"
        />

    <Button
        android:id="@+id/continueButton"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:textSize="20sp"
        android:text="Submit"
        android:textColor="@color/white"
        android:backgroundTint="@color/green"
        android:layout_gravity="center"
        android:layout_marginVertical="20dp"
        android:layout_below="@id/pasteClipboardButton"
        android:layout_centerHorizontal="true"
        android:gravity="center"

        />



<!--    </LinearLayout>-->

</RelativeLayout>